generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Recipe {
  id           String       @id @default(cuid())
  name         String
  description  String?
  servings     Int
  prepMins     Int?
  cookMins     Int?
  imageUrl     String?
  sourceUrl    String?
  sourceType   String       @default("manual")
  instructions String
  tags         String       @default("[]")
  calories     Int?
  proteinG     Float?
  carbsG       Float?
  fatG         Float?
  ingredients  Ingredient[]
  mealEntries  MealEntry[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Ingredient {
  id       String  @id @default(cuid())
  name     String
  quantity Float
  unit     String
  category String  @default("other")
  notes    String?
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String
}

model MealPlan {
  id            String      @id @default(cuid())
  weekStartDate String      @unique
  mealEntries   MealEntry[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model MealEntry {
  id            String   @id @default(cuid())
  mealPlan      MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  mealPlanId    String
  recipe        Recipe   @relation(fields: [recipeId], references: [id])
  recipeId      String
  dayOfWeek     String
  mealType      String
  people        Int      @default(2)
  extraServings Int      @default(0)
}
